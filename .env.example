# Copy this file to .env and adjust the paths below for your machine.
#   cp .env.example .env
#
# .env is gitignored -- these paths are host-specific and must not be committed.

# Path to this ProjectAirSim repo checkout. Defaults to "." (this file's own directory) if
# unset, so you normally don't need to set this at all.
#PROJECTAIRSIM_HOST_PATH=.

# Path to your Unreal Engine source checkout (matching unreal/Blocks/Blocks.uproject's
# "EngineAssociation", currently 5.2). No default -- required.
UE_ROOT_HOST_PATH=../UnrealEngine-5.2.0-release
