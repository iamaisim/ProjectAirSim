{
  // Unreal vehicle (Chaos physics in UE) controlled by SimpleDrive.
  // ProjectAirSim mirrors kinematics and applies SimpleDrive throttle /
  // steering / brake outputs to the UE vehicle each tick.

  "$schema": "../../projectairsim/src/projectairsim/schema/robot_config_schema.jsonc",

  "physics-type": "unreal-physics",

  // UE5 Blueprint or C++ class path for the unreal vehicle.
  "unreal-vehicle-class": "/ProjectAirSim/VehicleAdv/SUV/SuvCarPawn.SuvCarPawn_C",

  "controller": {
    "id": "Simple_Drive_Controller",
    "vehicle-setup": "ackermann",
    "type": "simple-drive-api",
    "simple-drive-api-settings": {
      "actuator-order": [
        { "id": "vehicle_throttle" },
        { "id": "vehicle_steering" },
        { "id": "vehicle_brake" }
      ]
    }
  },

  // Bridge SimpleDrive's [throttle, steering, brake] result to the parameter
  // indices consumed by the Unreal vehicle Blueprint.
  "actuators": [
    {
      "name": "vehicle_throttle",
      "type": "unreal-vehicle",
      "enabled": true,
      "unreal-vehicle-settings": {
        "parameter-index": 0,
        "control-signal-index": 0
      }
    },
    {
      "name": "vehicle_steering",
      "type": "unreal-vehicle",
      "enabled": true,
      "unreal-vehicle-settings": {
        "parameter-index": 2,
        "control-signal-index": 1
      }
    },
    {
      "name": "vehicle_brake",
      "type": "unreal-vehicle",
      "enabled": true,
      "unreal-vehicle-settings": {
        "parameter-index": 1,
        "control-signal-index": 2
      }
    }
  ],

  "sensors": [
    {
      "id": "Chase",
      "type": "camera",
      "enabled": true,
      "capture-interval": 0.03,
      "capture-settings": [
        {
          "image-type": 0,
          "width": 640,
          "height": 480,
          "fov-degrees": 90,
          "capture-enabled": true,
          "streaming-enabled": true,
          "pixels-as-float": false,
          "compress": false,
          "target-gamma": 2.5
        }
      ],
      "origin": {
        "xyz": "-10.0 1.5 -3.0",
        "rpy-deg": "0 -15 0"
      }
    }
  ]
}
